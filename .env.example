# Live website address (used for the sitemap, canonical links and Google structured data).
NEXT_PUBLIC_SITE_URL=https://baitsystematics.com

# Google Search Console > Add property > HTML tag: paste only the content="..." value here.
NEXT_PUBLIC_GSC_VERIFICATION=

# Google reviews section (components/home/GoogleReviews.jsx, app/api/reviews/route.js).
# 1. Create / claim your Google Business Profile for Bait Systematics (business.google.com).
# 2. Find its Place ID: https://developers.google.com/maps/documentation/places/web-service/place-id
# 3. In Google Cloud: enable "Places API (New)", create an API key (restrict it to that API).
# Copy this file to .env.local, fill both values, then restart `npm run dev`.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Google Analytics 4 measurement ID (already the default in components/CookieConsent.jsx). Loads only after a visitor accepts analytics cookies.
NEXT_PUBLIC_GA_ID=G-FVQHGWRJSL
